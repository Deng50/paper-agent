# ============================================================
# 文献情报 Agent · 环境变量模板
# 复制为 .env 后填写真实值。.env 已被 .gitignore，绝不入库。
# ============================================================

# ---- 运行环境 ----
ENV=dev                              # dev | prod（dev 才暴露 /docs /openapi.json）

# ---- API 鉴权（M1 必填）----
# 静态 Bearer Token，客户端带 Authorization: Bearer <API_TOKEN>
API_TOKEN=change-me-to-a-long-random-string

# ---- PostgreSQL（M1 必填）----
# 注意：用 psycopg3 驱动 → URL scheme 为 postgresql+psycopg
# docker compose 内主机名为服务名 postgres；本机调试用 localhost
DATABASE_URL=postgresql+psycopg://lit:lit@postgres:5432/lit_agent

# ---- Anthropic（M1 必填，/status 探针）----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# 第三方中转网关可选。留空 = 官方 api.anthropic.com。
# !! 填根域名，不要带 /v1 !!（SDK 自己拼 /v1/messages；带 /v1 会变成 /v1/v1/messages）
# 例：ANTHROPIC_BASE_URL=https://newapi.tsingyuai.com
ANTHROPIC_BASE_URL=

# ---- 记忆目录（默认 ./memory）----
MEMORY_DIR=./memory

# ---- 用户与时区 ----
USER_EMAIL=me@example.com
TIMEZONE=Asia/Shanghai
DAILY_PUSH_HOUR=10                   # 每日推送小时（本地时区），M3 用

# ---- Semantic Scholar（M2 必填，无默认 = fail-fast）----
# 申请：https://www.semanticscholar.org/product/api  限流 1 req/s 累计。
# 变量名 SEMANTIC_SCHOLAR_API_KEY（vendored 代码读它）；也兼容写成 S2_API_KEY。
SEMANTIC_SCHOLAR_API_KEY=
# S2 节流间隔秒（默认 1.1；连踩 429 调到 1.2）
S2_MIN_INTERVAL_S=1.1

# ---- paper-search-mcp（vendored 直接 import，无需此项；保留兼容）----
PAPER_SEARCH_MCP_CMD=

# ---- SMTP（M3 发邮件用，M1 可留空）----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 收件人固定取自 .env（PRD §5 安全）；多个用逗号分隔
SMTP_TO=
